# Copy to .env and fill in what you need. Never commit .env.
# Optional AI (planning, relevance ratings, Red Team reading, summaries). Without a key everything
# still works with rule-based methods. One line each, no quotes or spaces; restart the server after
# editing, then Settings -> Test connection -> Turn AI on.
#
# NVIDIA API catalog (build.nvidia.com -> Get API Key; the key starts with nvapi-):
NVIDIA_API_KEY=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
# Any chat model from https://build.nvidia.com/models, e.g. nvidia/nemotron-3-ultra-550b-a55b or
# mistralai/mistral-large-4-1t-a52b. Default: nvidia/nemotron-3.5-lightning-30b-a3b (fast).
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
#
# Or OpenAI (used only when no NVIDIA key is set, or when AI_PROVIDER=openai):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# AI_PROVIDER=nvidia     # pick explicitly if both keys are set
# AI_THINKING=on         # let NVIDIA reasoning models think before answering (slower)
# Optional: identifies the app to OpenAlex/Crossref ("polite pool") for faster, more reliable responses.
CONTACT_EMAIL=
# Optional: only if OpenAlex rate-limits you.
OPENALEX_API_KEY=
