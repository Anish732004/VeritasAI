# Copy to .env and fill in what you need. Never commit .env.
# Optional: enables AI planning, Red Team stance reading and summaries.
# One line, no quotes or spaces, e.g. OPENAI_API_KEY=sk-... then restart the server and use Settings -> Turn AI on.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: identifies the app to OpenAlex/Crossref ("polite pool") for faster, more reliable responses.
CONTACT_EMAIL=
# Optional: only if OpenAlex rate-limits you.
OPENALEX_API_KEY=
